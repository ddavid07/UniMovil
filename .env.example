# Copia este archivo a .env.local para desarrollo local.
# No introduzcas credenciales ni claves reales en este ejemplo versionado.

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173
# Configura según simulador/dispositivo; localhost no apunta al equipo en un móvil físico.
EXPO_PUBLIC_API_URL=

# Servicios externos: configurar cuando se implementen sus adaptadores.
MAPTILER_API_KEY=
OPENROUTESERVICE_API_KEY=

# Supabase: claves privadas solo en el backend; nunca usar EXPO_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
