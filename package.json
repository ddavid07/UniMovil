{
  "name": "unimovil",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand",
    "api:dev": "npm run dev --workspace=@unimovil/api",
    "api:start": "npm run start --workspace=@unimovil/api",
    "api:typecheck": "npm run typecheck --workspace=@unimovil/api",
    "api:test": "npm run test --workspace=@unimovil/api",
    "admin:dev": "npm run dev --workspace=@unimovil/admin",
    "admin:build": "npm run build --workspace=@unimovil/admin",
    "admin:typecheck": "npm run typecheck --workspace=@unimovil/admin",
    "admin:test": "npm run test --workspace=@unimovil/admin",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config apps/api/drizzle.config.ts",
    "db:setup-local": "npm run db:migrate && node scripts/setup-local-db-role.mjs",
    "db:seed-local": "node scripts/seed-local-incidents.mjs",
    "test:local-supabase": "npm run db:seed-local && node scripts/run-local-supabase-check.mjs",
    "supabase:start": "SUPABASE_EXPERIMENTAL_STACK=1 supabase start --runtime auto --eager",
    "supabase:stop": "SUPABASE_EXPERIMENTAL_STACK=1 supabase stop",
    "local:env": "node scripts/configure-local-env.mjs",
    "test:web": "node scripts/test-web.mjs",
    "check:expo": "npm run expo:check --workspace=@unimovil/mobile",
    "export:android": "node scripts/run-expo-local.mjs export:android",
    "export:ios": "node scripts/run-expo-local.mjs export:ios",
    "export:web": "node scripts/run-expo-local.mjs export:web",
    "mobile:start": "node scripts/run-expo-local.mjs start",
    "web:start": "node scripts/run-expo-local.mjs web",
    "mobile:android": "node scripts/run-expo-local.mjs android",
    "mobile:ios": "node scripts/run-expo-local.mjs ios"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "29.7.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supabase": "3.4.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
