{
  "name": "unimovil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de movilidad del campus de Moncloa de la Universidad Complutense de Madrid.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.0.0 <13"
  },
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@unimovil/mobile",
    "dev:api": "npm run start:dev --workspace=@unimovil/api",
    "dev:admin": "npm run dev --workspace=@unimovil/admin",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,css,html}\" \"packages/**/*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs}\" \"scripts/**/*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,md}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml,md}\" \"*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,yml,yaml,md}\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,css,html}\" \"packages/**/*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs}\" \"scripts/**/*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,md}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml,md}\" \"*.{js,jsx,ts,tsx,json,jsonc,mjs,cjs,yml,yaml,md}\"",
    "lint": "eslint .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
